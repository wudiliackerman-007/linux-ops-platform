    {
      "type": "timeseries",
      "title": "纾佺洏 IO 寤惰繜锛堣/鍐欙級",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_time_seconds_total{instance=~\"$node_instance\",device!~\"loop.*|ram.*\"}[$__rate_interval]) / clamp_min(rate(node_disk_reads_completed_total{instance=~\"$node_instance\",device!~\"loop.*|ram.*\"}[$__rate_interval]), 0.001)",
