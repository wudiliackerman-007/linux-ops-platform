    {
      "type": "timeseries",
      "title": "搴旂敤 QPS锛堟寜鐘舵€佺爜锛?,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(opslink_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
